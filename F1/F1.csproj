<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window on Windows; on Linux it is an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <!-- One build for Windows (Stream Deck) and Linux (OpenDeck); Windows-only code checks OperatingSystem.IsWindows(). -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>F1</AssemblyName>
    <RootNamespace>F1</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- SVG artwork rendered to PNG for the dial touch strip, on Windows and Linux alike (SkiaSharp). -->
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
  </ItemGroup>
</Project>
