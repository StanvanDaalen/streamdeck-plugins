{
    "UUID":  "com.stan.f1",
    "Name":  "F1",
    "Author":  "Stan",
    "Description":  "F1 kijken met MultiViewer en Ultimate F1 Viewer: vlaggen op je Hue-lampen, latency, volume, race- en quali-layouts en een F1 Mode die alles op een eigen bureaublad klaarzet.",
    "Version":  "1.13.0.0",
    "SDKVersion":  2,
    "Icon":  "images/plugin",
    "Category":  "F1",
    "CategoryIcon":  "images/category",
    "CodePathWin":  "bin/F1.exe",
    "PropertyInspectorPath":  "pi.html",
    "OS":  [
               {
                   "Platform":  "windows",
                   "MinimumVersion":  "10"
               }
           ],
    "Software":  {
                     "MinimumVersion":  "6.5"
                 },
    "Actions":  [
                    {
                        "UUID":  "com.stan.f1.mode",
                        "Name":  "F1 Mode",
                        "Tooltip":  "Drukken = F1 starten op het bureaublad F1 (MultiViewer en Ultimate F1 Viewer op hun plek, vlaggen, juiste layout). 1 seconde vasthouden = alles sluiten. Dubbelklikken = alles minimaliseren en dempen, nog eens = terug.",
                        "Icon":  "images/action-mode",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/key-mode",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.session",
                        "Name":  "Session",
                        "Tooltip":  "Sessie-info: resterende tijd (kwalificatie, training) of ronden (race). Drukken = wisselen naar het weer (baan- en luchttemperatuur, regen).",
                        "Icon":  "images/action-session",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-session",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
