{
    "UUID":  "com.stan.f1",
    "Name":  "F1 Race Control",
    "Author":  "Stan",
    "Description":  "Watch F1 with MultiViewer and Ultimate F1 Viewer: flags on your Hue lights, latency, volume, race and quali layouts, and an F1 Mode that sets everything up on its own desktop.",
    "Version": "1.13.9.0",
    "SDKVersion":  2,
    "Icon":  "images/plugin",
    "Category":  "F1 Race Control",
    "CategoryIcon":  "images/category",
    "CodePathWin":  "bin/F1.exe",
    "PropertyInspectorPath":  "pi.html",
    "OS":  [
               {
                   "Platform":  "windows",
                   "MinimumVersion":  "10"
               }
           ],
    "Software":  {
                     "MinimumVersion":  "6.5"
                 },
    "Actions":  [
                    {
                        "UUID":  "com.stan.f1.mode",
                        "Name":  "F1 Mode",
                        "Tooltip":  "Press = start F1 on the F1 desktop (MultiViewer and Ultimate F1 Viewer in place, flags, the right layout). Hold 1 second = stop what is running and close everything. Double-press = minimise and mute everything, again = bring it back.",
                        "Icon":  "images/action-mode",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/key-mode",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.session",
                        "Name":  "Session",
                        "Tooltip":  "Session info: time remaining (qualifying, practice) or laps (race). Press = switch to the weather (track and air temperature, rain).",
                        "Icon":  "images/action-session",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-session",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.flags",
                        "Name":  "Flags",
                        "Tooltip":  "Track status on your Hue lights: yellow, Safety Car/VSC, red and chequered. Key = on/off. Dial: turn = brightness, push = on/off, touch = test.",
                        "Icon":  "images/action-flags",
                        "Controllers":  [
                                            "Keypad",
                                            "Encoder"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-flags",
                                           "ShowTitle":  false
                                       }
                                   ],
                        "Encoder":  {
                                        "layout":  "layouts/f1.json",
                                        "Icon":  "images/action-flags",
                                        "TriggerDescription":  {
                                                                   "Rotate":  "Brightness",
                                                                   "Push":  "Flags on/off",
                                                                   "Touch":  "Test"
                                                               }
                                    }
                    },
                    {
                        "UUID":  "com.stan.f1.zone",
                        "Name":  "Flag lights",
                        "Tooltip":  "Choose which Hue room or zone shows the flags.",
                        "Icon":  "images/action-zone",
                        "Controllers":  [
                                            "Encoder"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/action-zone",
                                           "ShowTitle":  false
                                       }
                                   ],
                        "Encoder":  {
                                        "layout":  "layouts/f1.json",
                                        "Icon":  "images/action-zone",
                                        "TriggerDescription":  {
                                                                   "Rotate":  "Choose room / zone"
                                                               }
                                    }
                    },
                    {
                        "UUID":  "com.stan.f1.volume",
                        "Name":  "Volume",
                        "Tooltip":  "Volume of only the main F1 LIVE stream in MultiViewer (never an onboard). Turn = louder/quieter, push = mute.",
                        "Icon":  "images/action-volume",
                        "Controllers":  [
                                            "Encoder"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/action-volume",
                                           "ShowTitle":  false
                                       }
                                   ],
                        "Encoder":  {
                                        "layout":  "layouts/f1.json",
                                        "Icon":  "images/action-volume",
                                        "TriggerDescription":  {
                                                                   "Rotate":  "Volume",
                                                                   "Push":  "Mute",
                                                                   "Touch":  "Mute"
                                                               }
                                    }
                    },
                    {
                        "UUID":  "com.stan.f1.latency",
                        "Name":  "Live delay",
                        "Tooltip":  "Delay behind live (or offset of a replay) as 0s, -40s or +3s. Turn = shift, push = go live, touch = pause.",
                        "Icon":  "images/action-latency",
                        "Controllers":  [
                                            "Encoder"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/action-latency",
                                           "ShowTitle":  false
                                       }
                                   ],
                        "Encoder":  {
                                        "layout":  "layouts/f1.json",
                                        "Icon":  "images/action-latency",
                                        "TriggerDescription":  {
                                                                   "Rotate":  "1 s per click",
                                                                   "Push":  "Go live",
                                                                   "Touch":  "Pause / play"
                                                               }
                                    }
                    },
                    {
                        "UUID":  "com.stan.f1.live",
                        "Name":  "Go live",
                        "Tooltip":  "Shows where you are (YOU\u0027RE LIVE, -40s, REPLAY). Press = go live, or back to 0s in a replay.",
                        "Icon":  "images/action-live",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-live",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.sync",
                        "Name":  "Sync",
                        "Tooltip":  "Syncs all players (onboards, extra feeds) with the main screen.",
                        "Icon":  "images/action-sync",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/key-sync",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.pause",
                        "Name":  "Pause / play",
                        "Tooltip":  "Pauses or resumes the streams; time spent paused counts as delay behind live.",
                        "Icon":  "images/action-pause",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-pause",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.fullscreen",
                        "Name":  "Fullscreen",
                        "Tooltip":  "Main MultiViewer screen fullscreen on/off.",
                        "Icon":  "images/action-fullscreen",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "DisableAutomaticStates":  true,
                        "States":  [
                                       {
                                           "Image":  "images/key-fullscreen",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.race",
                        "Name":  "Race",
                        "Tooltip":  "Opens your MultiViewer setup Race and the Ultimate F1 Viewer layout Race, with the two best drivers of the rest in the free onboard slots. Pressing again while it is busy or already open does nothing. Hold 1 second = stop what is running and close everything, like F1 Mode.",
                        "Icon":  "images/action-race",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/key-race",
                                           "ShowTitle":  false
                                       }
                                   ]
                    },
                    {
                        "UUID":  "com.stan.f1.quali",
                        "Name":  "Quali",
                        "Tooltip":  "Opens your MultiViewer setup Qualifying and the Ultimate F1 Viewer layout Qualifying, with the two best drivers of the rest in the free onboard slots. Pressing again while it is busy or already open does nothing. Hold 1 second = stop what is running and close everything, like F1 Mode.",
                        "Icon":  "images/action-quali",
                        "Controllers":  [
                                            "Keypad"
                                        ],
                        "States":  [
                                       {
                                           "Image":  "images/key-quali",
                                           "ShowTitle":  false
                                       }
                                   ]
                    }
                ]
}