{
  "UUID": "com.stan.ps5",
  "Name": "PlayStation 5 for OBS",
  "Author": "Stan",
  "Description": "Hear your PlayStation 5 through OBS and a capture card: control the volume from a dial and see whether the console is on.",
  "Version": "1.1.2.0",
  "SDKVersion": 2,
  "Icon": "images/plugin",
  "Category": "PlayStation 5 for OBS",
  "CategoryIcon": "images/category",
  "CodePathWin": "bin/PS5.exe",
  "PropertyInspectorPath": "pi.html",
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Software": { "MinimumVersion": "6.5" },
  "Actions": [
    {
      "UUID": "com.stan.ps5.audio",
      "Name": "PS5 Volume",
      "Tooltip": "Turn: volume. Pressed turn: Discord volume. Press: mute (or start OBS). Hold: default volume.",
      "Icon": "images/action",
      "Controllers": ["Encoder"],
      "DisableAutomaticStates": true,
      "States": [{ "Image": "images/key" }],
      "Encoder": {
        "layout": "layouts/ps5.json",
        "Icon": "images/action",
        "TriggerDescription": { "Rotate": "Volume (pressed: Discord)", "Push": "Mute / start OBS", "Touch": "Mute / start OBS", "LongTouch": "Default volume" }
      }
    }
  ]
}
