<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Scarlett</AssemblyName>
    <RootNamespace>ScarlettSwitch</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <!-- Icons, image loading, the icon library and the log are shared with Volume & Launcher. -->
    <Compile Include="..\VolumeLauncher\src\ArtworkService.cs" Link="Shared\ArtworkService.cs" />
    <Compile Include="..\VolumeLauncher\src\Icons.cs" Link="Shared\Icons.cs" />
    <Compile Include="..\VolumeLauncher\src\Native.cs" Link="Shared\Native.cs" />
    <Compile Include="..\VolumeLauncher\src\SettingsStore.cs" Link="Shared\SettingsStore.cs" />
    <Compile Include="..\VolumeLauncher\src\GameDetection.cs" Link="Shared\GameDetection.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>
