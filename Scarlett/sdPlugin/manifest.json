{
  "UUID": "com.stan.scarlett",
  "Name": "Scarlett Switch",
  "Author": "Stan",
  "Description": "Switch a Focusrite Scarlett between speakers and headphones from a key or a dial, and turn the Windows volume on the dial. Needs a Focusrite Scarlett, Focusrite Control 2 and a MIDI loopback port.",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Icon": "images/plugin",
  "Category": "Scarlett Switch",
  "CategoryIcon": "images/category",
  "CodePathWin": "bin/Scarlett.exe",
  "PropertyInspectorPath": "pi.html",
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Software": { "MinimumVersion": "6.5" },
  "Actions": [
    {
      "UUID": "com.stan.scarlett.switch",
      "Name": "Scarlett Switch",
      "Tooltip": "Switch between speakers and headphones. Key: press = switch. Dial: press or tap = switch, turn = Windows volume, long touch = mute.",
      "Icon": "images/action-output",
      "Controllers": ["Keypad", "Encoder"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "images/key-speakers-on", "ShowTitle": true },
        { "Image": "images/key-headphones-on", "ShowTitle": true }
      ],
      "Encoder": {
        "layout": "layouts/icon.json",
        "Icon": "images/action-output",
        "TriggerDescription": { "Push": "Switch", "Touch": "Switch", "LongTouch": "Mute", "Rotate": "Volume" }
      }
    },
    {
      "UUID": "com.stan.scarlett.speakers",
      "Name": "Speakers",
      "Tooltip": "Switch the Scarlett to the speakers (Output 1-2). Lights up while the speakers are on.",
      "Icon": "images/action-speakers",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "images/key-speakers-off", "ShowTitle": false },
        { "Image": "images/key-speakers-on", "ShowTitle": false }
      ]
    },
    {
      "UUID": "com.stan.scarlett.headphones",
      "Name": "Headphones",
      "Tooltip": "Switch the Scarlett to the headphones. Lights up while the headphones are on.",
      "Icon": "images/action-headphones",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [
        { "Image": "images/key-headphones-off", "ShowTitle": false },
        { "Image": "images/key-headphones-on", "ShowTitle": false }
      ]
    }
  ]
}
