{
  "UUID": "com.stan.spotify",
  "Name": "Better Spotify Dial",
  "Author": "Stan",
  "Description": "Spotify on a Stream Deck + dial, like the official plugin, with your own actions for click, double-click, triple-click and hold.",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Icon": "imgs/plugin",
  "Category": "Better Spotify Dial",
  "CategoryIcon": "imgs/category",
  "CodePathWin": "bin/StanSpotify.exe",
  "PropertyInspectorPath": "pi.html",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.5"
  },
  "ApplicationsToMonitor": {
    "windows": [
      "Spotify.exe"
    ]
  },
  "Actions": [
    {
      "UUID": "com.stan.spotify.player",
      "Name": "Better Spotify Dial",
      "Tooltip": "Track, cover and progress. Turn for volume or skip, hold and turn to seek. Choose what click, double-click, triple-click and hold do.",
      "Icon": "imgs/action",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/action"
        }
      ],
      "Encoder": {
        "layout": "layouts/player.json",
        "Icon": "imgs/action",
        "TriggerDescription": {
          "Rotate": "Volume / Skip",
          "Push": "Click, double, triple, hold",
          "Touch": "Play / Pause",
          "LongTouch": "Previous / Next"
        }
      }
    }
  ]
}
