{
  "UUID": "com.stan.launcher",
  "Name": "Launcher",
  "Author": "Stan",
  "Description": "Keys to start, minimize and close games and apps, with playtime.",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Icon": "images/plugin",
  "Category": "Launcher",
  "CategoryIcon": "images/category",
  "CodePathWin": "bin/Launcher.exe",
  "PropertyInspectorPath": "pi.html",
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Software": { "MinimumVersion": "6.5" },
  "Actions": [
    {
      "UUID": "com.stan.launcher.game",
      "Name": "Game Key",
      "Tooltip": "The game that is open right now, or one game you choose, with playtime. Click: start, minimize or show. Hold: close.",
      "Icon": "images/action-game",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [{ "Image": "images/key-game", "ShowTitle": false }]
    },
    {
      "UUID": "com.stan.launcher.fixedgame",
      "Name": "Fixed Game Key",
      "Tooltip": "Key for one game. Click: start, minimize or show. Hold: close.",
      "Icon": "images/action-game",
      "Controllers": ["Keypad"],
      "VisibleInActionsList": false,
      "DisableAutomaticStates": true,
      "States": [{ "Image": "images/key-game", "ShowTitle": false }]
    },
    {
      "UUID": "com.stan.launcher.app",
      "Name": "App Key",
      "Tooltip": "Click: minimize, show or open. Hold: close.",
      "Icon": "images/action-app",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [{ "Image": "images/key-app", "ShowTitle": false }]
    }
  ]
}
